{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5hirish/ultrastable/spec/policy.schema.json",
  "title": "Ultrastable autonomy policy",
  "description": "Which change classes may ship at which autonomy level. Edited only by humans.",
  "type": "object",
  "required": ["version", "promotion", "classes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0.1" },
    "promotion": {
      "type": "object",
      "required": ["clean_changes_required"],
      "additionalProperties": false,
      "properties": {
        "clean_changes_required": { "type": "integer", "minimum": 1 },
        "demote_to_on_incident": { "enum": ["A0", "A1"] }
      }
    },
    "classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["level", "cap"],
        "additionalProperties": false,
        "properties": {
          "level": { "enum": ["A0", "A1", "A2", "A3"] },
          "cap": { "enum": ["A0", "A1", "A2", "A3"] },
          "paths": { "type": "array", "items": { "type": "string" } },
          "canary_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
